# Naumi environment variables.
#
# 推荐用 docker compose 部署(见 docker-compose.yml)——数据库/存储/密钥都已配好,
# 打开站点走「首启配置向导」填 OpenAI API Key 即可,基本不需要手改本文件。
# 手动部署(npm run build && npm start)时,复制本文件为 `.env.local` 再填。

# --- Public commerce ---
# 内测默认关闭价格、充值、购买与公开销售页；正式开放商业化时改为 1。
NAUMI_PUBLIC_COMMERCE=0

# --- Database (Postgres) ---
# 必填(生产)。用户/积分/作品/设置都存这里,schema 首次访问自动建。
# docker compose 已内置;手动部署可用任意 Postgres(自建 / Supabase / RDS / Neon)。
DATABASE_URL=

# --- Settings encryption ---
# 用于会话签名和加密设置；至少 32 字符，建议 openssl rand -hex 32。
# 已有部署更换前须运行 scripts/rotate-settings-secret.mjs 迁移密文；旧会话会失效。
SETTINGS_SECRET=

# --- AI image generation (OpenAI) ---
# 可留空:首启向导 / 管理后台里填,加密存数据库(推荐)。也可在此用 env 提供。
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# 前台允许切换的生图模型，逗号分隔；只填写上游实际可用的模型，留空时仅使用默认模型。
OPENAI_IMAGE_MODELS=
# New API 的 image 分组令牌。配置后自动从 /v1/models 同步 Gemini / Imagen 生图模型。
NEW_API_IMAGE_BASE_URL=
NEW_API_IMAGE_API_KEY=
# 仅在模型目录接口暂时不可用时作为兜底，逗号分隔；正常可留空。
NEW_API_IMAGE_MODELS=
# 中国大陆服务器直连不了 api.openai.com:填任意 OpenAI 兼容中转/网关地址即可
# (自建海外中转或第三方中转均可,如 https://your-relay.example.com/v1)
OPENAI_BASE_URL=
# 画布在线改字：优先调用 PaddleOCR HTTP 服务；未配置时回退到视觉模型。
PADDLE_OCR_BASE_URL=
PADDLE_OCR_API_KEY=
PADDLE_OCR_REQUIRED=false
PADDLE_OCR_FALLBACK_MODEL=
# 单次请求超时、瞬时错误最大尝试数、最低置信度（低于阈值的噪声不进入改字列表）。
PADDLE_OCR_TIMEOUT_MS=35000
PADDLE_OCR_MAX_ATTEMPTS=2
PADDLE_OCR_MIN_CONFIDENCE=0.12
# 用户自定义图片接口在生产环境默认禁止访问 localhost / 内网。
# 自托管部署确需连接局域网图片站时显式设为 true。
USER_IMAGE_PROVIDER_ALLOW_PRIVATE_NETWORK=false

# --- Agent(智能工作台) ---
# 智能体大脑模型(OpenAI 兼容;默认 qwen3.8-flash)
AGENT_MODEL=
# 视觉输入:默认按模型名自动判定(gpt-4o/gpt-5*/claude/gemini/qwen-vl 等视为支持图片;
# 发图被拒会自动降级纯文本)。特殊中转站可强制:1=始终开,0=始终关。
AGENT_VISION=

# --- Storage ---
# 默认本地磁盘(MEDIA_DIR,docker 卷 /data/media),零配置可用。
# STORAGE_DRIVER=s3 可接 Garage/MinIO/OSS/COS 等 S3-compatible 存储。
STORAGE_DRIVER=local
MEDIA_DIR=./data/media
# redirect preserves existing reachable object-store URLs; proxy keeps NAS traffic server-side.
MEDIA_REMOTE_ACCESS=redirect
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
# 留空时仍输出 /media/<key>，由应用流式代理私有 bucket。
S3_PUBLIC_BASE_URL=
# Cloudflare R2 兼容配置；未显式指定 STORAGE_DRIVER 时仍可自动识别。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Auth (Supabase Auth, 可选) ---
# 三个都填启用真实多用户登录(多用户注册为 Pro 能力);留空为单机模式。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 管理员邮箱(该 Supabase 用户可见 /admin 管理后台)
ADMIN_EMAIL=

# --- Edition / Pro license ---
# 开源版留空即可。购买 Pro 商业授权后:
#   NAUMI_EDITION=pro + PRO_LICENSE_KEY=NOVA-XXXX-...(或在首启向导里填 Key)
NAUMI_EDITION=
PRO_LICENSE_KEY=
# License 签发/校验服务器，按实际服务显式配置
LICENSE_SERVER_URL=
# 更新服务地址；留空不请求外部更新服务
UPDATE_SERVER_URL=

# --- Branding (可选,build 期内联;运行时品牌请用后台「品牌与白标」) ---
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_EMAIL=
# 云端托管开通页面的完整 http(s) URL；留空不显示外部购买链接
NEXT_PUBLIC_CLOUD_BUY_URL=
# 内部登录身份域名，非对外邮箱。新实例默认使用 Naumi 内部域名。
# 既有实例保留原账号域名，手机号服务端/浏览器域名必须一致，不能当作品牌文案迁移。
PHONE_EMAIL_DOMAIN=
NEXT_PUBLIC_PHONE_EMAIL_DOMAIN=
WECHAT_EMAIL_DOMAIN=

# --- Video generation (OpenAI videos 协议聚合商/官方端点) ---
# 三项齐备才启用 OpenAI Videos 兼容通道;模型须兼容 POST /v1/videos 三件套
VIDEO_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_MODEL=
VIDEO_API_MODELS=
# 每条视频扣积分(预扣,失败自动退),默认 20。多供应商可用 VIDEO_PROVIDERS_JSON。
VIDEO_TASK_COST=20
# 后台恢复 worker(instrumentation 常驻):多实例部署时旁路实例设 0,默认开启
# NAUMI_VIDEO_WORKER=0
# 视频生成：可继续使用单一 OpenAI Videos 兼容端点，也可用 VIDEO_PROVIDERS_JSON 配多供应商。
VIDEO_PROVIDERS_JSON=
VIDEO_WORKER_SECRET=
VIDEO_WORKER_INTERVAL_MS=15000

# --- Multi-instance control (default off; secrets server-side only) ---
FLEET_CONTROL_ENABLED=0
# Restricted central sidecar only; dedicated build has /fleet-assets prefix.
FLEET_PORTAL_ONLY=0
FLEET_CONNECTOR_ENABLED=0
FLEET_SCHEDULER_ENABLED=0
FLEET_CENTRAL_URL=
# Optional operator-managed private PKI/origin routing; hostname/SNI verification stays on.
FLEET_CENTRAL_CA_FILE=
FLEET_CENTRAL_RESOLVE_IP=
FLEET_INSTANCE_ID=
FLEET_INSTANCE_TOKEN=
FLEET_RELEASE_DISPATCH_ENABLED=0
FLEET_RELEASE_RELAY_ENABLED=0
FLEET_RELEASE_INBOX=
FLEET_RELEASE_OUTBOX=
FLEET_RELEASE_SIGNING_PRIVATE_KEY=
FLEET_RELEASE_SIGNING_PRIVATE_KEY_FILE=
FLEET_RELEASE_SIGNING_PUBLIC_KEY=
FLEET_APP_ORIGIN=
FLEET_DESKTOP_ORIGIN=
FLEET_ENTERPRISE_ORIGIN=
# Host-network connector: root-owned read-only status file follows switched slots.
FLEET_ACTIVE_SLOTS_FILE=
# Server-owned provider capacity override. Empty keeps historical finite budgets.
# Comma-separated exact provider IDs; e.g. geeknow-images. Never set from user input.
NAUMI_UNLIMITED_CONCURRENCY_PROVIDERS=

# --- Managed model transport (optional; exact server-approved origins only) ---
MODEL_CONFIG_PROXY_URL=
# Include a supplier's output-image origin when it also needs the approved proxy.
# 47 Geeknow example: https://api.apimart.ai,https://www.geeknow.top,https://r2.geeknow.ai
# Do not add these origins to MODEL_CONFIG_TRUSTED_ORIGINS: DNS/private-host validation stays enabled.
MODEL_CONFIG_PROXY_ORIGINS=
