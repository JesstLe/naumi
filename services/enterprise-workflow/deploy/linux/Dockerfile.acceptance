ARG POSTGRES_IMAGE=postgres@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
ARG RUNTIME_IMAGE=naumi-enterprise-runtime:explicit-required
FROM ${RUNTIME_IMAGE} AS runtime
# The test layer alone includes pg_dump/pg_restore. No Docker socket or client.
FROM ${POSTGRES_IMAGE}
COPY --from=runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=runtime /usr/lib/libstdc++.so.6 /usr/lib/libstdc++.so.6
COPY --from=runtime /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1
COPY --from=runtime /app /app
COPY acceptance.mjs /app/acceptance.mjs
WORKDIR /scratch
USER 1000:1000
ENTRYPOINT ["node", "/app/acceptance.mjs"]
