# Same application image, generic S3 API. Replace placeholders in deployment secrets.
STORAGE_DRIVER=s3
MEDIA_PRIVATE=1
MEDIA_REMOTE_ACCESS=proxy
MEDIA_DIR=/data/media
S3_ENDPOINT=https://nas-gateway.example.invalid
S3_REGION=us-east-1
S3_BUCKET=naumi-media
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
