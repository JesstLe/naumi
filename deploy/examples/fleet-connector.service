[Unit]
Description=Naumi private enterprise management connector
After=network-online.target

[Service]
Type=simple
User=naumi
Group=naumi-fleet
WorkingDirectory=/opt/naumi-control
EnvironmentFile=/etc/naumi/fleet-instance.env
ExecStart=/usr/bin/node /opt/naumi-control/dist/fleet/connector.js
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/naumi-control
ReadOnlyPaths=/var/lib/naumi-fleet/outbox
ReadWritePaths=/var/lib/naumi-fleet/inbox

[Install]
WantedBy=multi-user.target
