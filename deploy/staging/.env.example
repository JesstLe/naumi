# Template only. No production secrets or full data in Git.
# Populate privately in /opt/naumi-staging/config/.env (chmod 600).
NAUMI_STAGING_ENV_FILE=/opt/naumi-staging/config/.env
NAUMI_IMAGE=ghcr.io/jesstle/naumi:84e1afdee61013f3d5320b00bf688ae125b98179
POSTGRES_USER=naumi_staging
POSTGRES_DB=naumi_staging
POSTGRES_PASSWORD=
SETTINGS_SECRET=
VIDEO_WORKER_SECRET=
STORAGE_DRIVER=local
MEDIA_DIR=/data/media
NAUMI_VIDEO_WORKER=0
# Isolated Router instance/config must be ready before actual model tests.
NAUMI_ROUTER_MANAGEMENT_URL=
NAUMI_ROUTER_MANAGEMENT_TOKEN=
NAUMI_ROUTER_GENERATION_URL=
NAUMI_ROUTER_GENERATION_TOKEN=
NAUMI_ROUTER_COST_URL=
NAUMI_ROUTER_COST_TOKEN=
MODEL_CONFIG_ENVELOPE_SECRET=
MODEL_CONFIG_TRUSTED_ORIGINS=
